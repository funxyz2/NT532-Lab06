# Secret-bearing environment files at any depth. Keep templates readable.
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Virtual environments contain installed dependencies, not project source.
.venv/**
venv/**

# Large FaceNet model artifacts (~225 MB) and photo datasets (~85 MB).
/source 1/Models/**
/source 1/Dataset/**

# Binary MTCNN weights are runtime assets, not source code.
/source 1/src/align/det*.npy

# Generated Python caches and compiled bytecode.
__pycache__/**
*.py[cod]

# Runtime outputs: relayed image and generated attendance database.
/source 2/PROCESSED.png
/iot_platform/data/**

# OS metadata.
.DS_Store
