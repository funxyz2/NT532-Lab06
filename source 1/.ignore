# Secret-bearing environment files. Keep templates readable.
/.env
/.env.*
!/.env.example
!/.env.template
!/.env.sample

# Virtualenv (1.7G) — heavy TF1 stack, not needed for code questions
/.venv/**

# Large binary model artifacts (~225M) — not needed for architecture/code
/Models/**

# Raw/unprocessed photo dataset (~83M) — not needed for code questions
/Dataset/raw/**

# Aligned face crops + MTCNN bounding-box logs — data, not code
/Dataset/processed/**

# MTCNN network weights (binary .npy) loaded at runtime via create_mtcnn()
/src/align/det*.npy

# Python bytecode caches
/__pycache__/**
/src/**/__pycache__/**

# macOS junk
.DS_Store
